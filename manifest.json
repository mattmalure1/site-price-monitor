{
  "manifest_version": 3,
  "name": "Discord Chat Exporter",
  "version": "1.0.0",
  "description": "Export Discord messages and attachments from any channel or DM. Supports JSON, HTML, TXT, and CSV formats with optional attachment downloading.",
  "permissions": [],
  "host_permissions": [
    "*://discord.com/*",
    "*://discordapp.com/*",
    "*://cdn.discordapp.com/*",
    "*://media.discordapp.net/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://discord.com/*", "*://discordapp.com/*"],
      "js": [
        "channel-detector.js",
        "api-client.js",
        "zip-writer.js",
        "attachment-downloader.js",
        "formatters/json-formatter.js",
        "formatters/html-formatter.js",
        "formatters/txt-formatter.js",
        "formatters/csv-formatter.js",
        "exporter-content.js"
      ],
      "css": ["exporter-panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["exporter-inject.js", "exporter-panel.css"],
      "matches": ["*://discord.com/*", "*://discordapp.com/*"]
    }
  ]
}
